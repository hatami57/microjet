# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
# go.work is committed: this is a multi-module monorepo and the workspace is the
# canonical local dev setup (lets `go build/test ./...` span all modules without
# replace directives that would leak into published modules).
go.work.sum

# env file
.env

.idea/

# Compiled example binaries (same name as their directory, no extension)
examples/http-postgres/http-postgres
examples/minimal/minimal
examples/sqlite/sqlite
examples/features/features

# SQLite database files created by examples at runtime
*.db

