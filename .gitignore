# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
# go.work is committed: this is a multi-module monorepo and the workspace is the
# canonical local dev setup (lets `go build/test ./...` span all modules without
# replace directives that would leak into published modules).
go.work.sum

# env file
.env

.idea/

# Compiled example binaries — each example builds to a binary named after its
# directory (e.g. examples/errors/errors). Ignore that pattern for every example
# so a stray `go build` in an example dir is never committed.
examples/*/aws
examples/*/cache
examples/*/compound-orders
examples/*/config
examples/*/converters
examples/*/errors
examples/*/features
examples/*/http-client
examples/*/http-postgres
examples/*/idempotency
examples/*/logging
examples/*/messaging
examples/*/migrations
examples/*/minimal
examples/*/modules
examples/*/money
examples/*/outbox
examples/*/sqlite
examples/*/time
examples/*/tracing
/http-postgres
/minimal
/sqlite
/features
/modules

# SQLite database files created by examples at runtime
*.db

